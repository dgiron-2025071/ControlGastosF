PORT=3000

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=control_gastos
DATABASE_USER=postgres
DATABASE_PASSWORD=(su contraseña de postgres)

JWT_SECRET=change_this_to_a_long_random_secret
# El JWT se renueva mientras el usuario sigue interactuando (sesión por inactividad)
JWT_EXPIRES_IN=2m

CORS_ORIGIN=http://localhost:4200

# Google OAuth 2.0 - Opcional. Si se omite, el backend usa el mismo ID de cliente de Google
# que viene configurado en el frontend (frontend/src/environments/environment.ts).
# GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
